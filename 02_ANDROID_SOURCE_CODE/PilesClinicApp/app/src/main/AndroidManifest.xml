    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- ⏰🔒 V1241 (০৮.০৯.২০২৬, TK-নির্দেশ হুবহু: *"জোর করে আসতে হবে — যে টাইম
         সেট করবে সেই টাইমে সেই ডাক্তারবাবুকে জোর করে নোটিফিকেশন দিতে হবে"*)।
         Doctor Reminder-এর ঘণ্টা এতদিন শুধু পিছনের প্রতি-১৫-মিনিটের কাজে বাজত,
         যেটা ফোন ইচ্ছেমতো পিছিয়ে দিতে পারে। এখন বাছা সময়ে ফোনের নিজের
         **অ্যালার্ম ঘড়ি** বসে, তাই কাঁটায়-কাঁটায় বাজে।
         · USE_EXACT_ALARM — Android 13+ (নিজে থেকেই দেওয়া থাকে)
         · SCHEDULE_EXACT_ALARM — Android 12 ও 12L (ইনস্টলেই দেওয়া থাকে)
         ⛔ অনুমতি না থাকলে কোড নিজেই কাছাকাছি সময়ে বসায়, আর পুরনো
            ১৫-মিনিটের জালটা আগের মতোই থাকে — কিছুই ভাঙে না। -->
    <!-- ⏰ V1277 — ফোন চালু হলে অ্যালার্মগুলো আবার বসানোর জন্য (তালিকা সারি ৪০০) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <!-- 🔴🆕🔒 খাতার সারি B440 (05.08.2026, TK-নির্দেশ) — Work Notebook-এ
         "Outside Calls Today" ঘরের ডিফল্ট মান স্বয়ংক্রিয়ভাবে ফোনের
         Incoming Call থেকে গণনা করতে। ⛔ স্টাফ Allow না করলে/এই অনুমতি না
         থাকলে ঘরটা আগের মতোই সম্পূর্ণ হাতে-লেখা থেকে যায়, কিছুই আটকায় না। -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />

    <!-- 🪟🔒 V845 (৩০.০৮.২০২৬, TK-নির্দেশ, ফটো-প্রুফ পাশ) — কল বাজার সময়
         ফোনের নিজের কল-স্ক্রিন পুরো পর্দা ঢেকে রাখে, তাই অ্যাপের
         নোটিফিকেশন পিছনে চলে যেত (TK: *"ফোন কল কাটার পরে কেন এটা আসবে…
         আমি চাইছি ডিউরিং ফোন কলে"*)। এই অনুমতিটাই কল-স্ক্রিনের **উপরে**
         ভাসমান কার্ড আঁকতে দেয় (Truecaller যেভাবে দেখায়)।
         ⛔ এটা "special" অনুমতি — নিজে থেকে চালু হয় না, প্রতিটা ফোনে
            স্টাফকে একবার হাতে চালু করতে হয় (Settings → Display over
            other apps)। **না দিলে কিচ্ছু ভাঙে না** — তখন আজকের মতোই
            শুধু নোটিফিকেশন আসবে। -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 🔴🆕🔒 B441 (05.08.2026, TK-নির্দেশ) — দুই-SIM ফোনে কোন SIM
         ব্রাঞ্চের নম্বর তা আলাদা করতে (নইলে দুটো SIM-এর কল মিলিয়ে ভুল
         সংখ্যা দেখাত)। ⛔ না দিলে/না থাকলে সব SIM মিলিয়ে গোনে, আটকায় না। -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 👆🔒 V496 (২১.০৮.২০২৬, TK §৩): Staff-এর হাজিরা ও Doctor-এর অ্যাপ খোলার
         জন্য Android-এর নিরাপদ আঙুলের-ছাপ পর্দা। ⛔ কোনো আঙুলের ছাপ বা ছবি
         অ্যাপে/ক্লাউডে যায় না — Android শুধু সফল/ব্যর্থ জানায়। -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-feature android:name="android.hardware.fingerprint" android:required="false" />

    <!-- 📍🔒 V496 (TK §৫): Staff-এর IN TIME-এ "ক্লিনিকে আছেন কিনা" দেখার জন্য।
         ⛔ GPS সারাক্ষণ চলে না — শুধু IN TIME চাপার মুহূর্তে, ফল পেলেই বন্ধ।
         ⛔ background location চাওয়া হয়নি; অবস্থান কোথাও সেভ/পাঠানো হয় না। -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <!-- 🏍️🔒 V968 (০২.০৯.২০২৬, TK-নির্দেশ): শুধু বাইরে ঘোরা স্টাফের (RUPAM)
         Field Visit-এ IN TIME থেকে OUT TIME পর্যন্ত কিলোমিটার গোনার জন্য।
         ⛔ background location চাওয়া হয়নি — foreground service চলা অবস্থায়ই
            অবস্থান নেওয়া হয়, আর স্থায়ী নোটিফিকেশন দেখানো হয় (Android-এর নিয়ম;
            TK-কে কাজ শুরুর আগেই জানানো হয়েছে)। -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- 🔴🔴🔴 TK-রিপোর্ট (05.08.2026) — IN/OUT TIME · Call Reminder ·
         Chamber Close Reminder তিনটেই ব্যাকগ্রাউন্ডে (WorkManager) চলে;
         অ্যাপ বন্ধ থাকলে কিছু ফোনের (Xiaomi/Vivo/Oppo-ঘরানার) নিজস্ব
         ব্যাটারি-সেভিং এই কাজ আটকে দেয়। এই অনুমতি (শুধু নিজের অ্যাপের
         জন্য, সিস্টেম পপ-আপে স্টাফ নিজে অনুমতি দেবেন) ছাড়া রিমাইন্ডার
         নির্ভরযোগ্যভাবে আসতেই পারে না। ⛔ অন্য কোনো অ্যাপ/সিস্টেম আচরণ
         এতে ছোঁয়া হয় না, শুধু এই একটা অ্যাপকে ব্যাটারি-সেভিং থেকে বাদ
         রাখতে বলা হয়। -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- TK-APPROVED (2026-07-28): Android 11 theke onno app "dekha jay na"
         jodi na ekhane lekha thake. Eta na thakle WhatsApp install thakleo
         chobi-soho pathano kaj korto na. Sudhu ei duto app o SMS app dekha
         jay; onno kono app-er tothyo neoya hoy na. -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <!-- V235 (TK, Call Chooser project-wide): Android 11+ e dialer app-gulo
             "dekha jay na" jodi ei tel: query na thake. Eta na thakle CallChooser-er
             queryIntentActivities(ACTION_DIAL) khali list dey, tai custom chooser
             kaj kore na o Vivo/Samsung-e phone sorasori default dialer khule jay.
             ACTION_DIAL o ACTION_VIEW duto tel scheme dhora holo jate sob installed
             dialer (Phone / Super Phone / etc.) chooser-e dekha jay. -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tel" />
        </intent>
    </queries>

